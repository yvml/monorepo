{
  "name": "@yvml/studio",
  "version": "1.0.0",
  "private": true,
  "description": "Sanity Studio for YVML",
  "type": "module",
  "exports": {
    "./config": "./sanity.config.ts"
  },
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "typegen": "sanity schema extract --force && sanity typegen generate",
    "typegen:generate": "sanity typegen generate",
    "clean": "rm -rf dist .sanity .turbo node_modules",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hmidmismi/sanity-core": "workspace:*",
    "@sanity/assist": "6.3.0",
    "@sanity/client": "^8.17.0",
    "@sanity/code-input": "^7.3.16",
    "@sanity/icons": "^5.4.0",
    "@sanity/table": "^3.1.21",
    "@sanity/ui": "^4.4.12",
    "@sanity/vision": "^6.25.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "sanity": "^6.25.0",
    "sanity-plugin-internationalized-array": "^5.3.10",
    "sanity-plugin-media": "^6.6.4",
    "sanity-plugin-mux-input": "^5.3.1",
    "styled-components": "^6.7.0"
  },
  "devDependencies": {
    "@hmidmismi/tsconfig": "workspace:*",
    "@sanity/cli": "^8.35.0",
    "@types/react": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "license": "UNLICENSED"
}
