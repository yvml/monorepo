{
  "name": "@yvml/studio",
  "version": "1.0.0",
  "private": true,
  "description": "Sanity Studio for YVML",
  "type": "module",
  "exports": {
    "./config": "./sanity.config.ts"
  },
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "typegen": "sanity schema extract --force && sanity typegen generate",
    "typegen:generate": "sanity typegen generate",
    "clean": "rm -rf dist .sanity .turbo node_modules",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hmidmismi/sanity-core": "workspace:*",
    "@sanity/assist": "6.3.0",
    "@sanity/client": "^7.20.0",
    "@sanity/code-input": "^7.3.10",
    "@sanity/icons": "^3.7.4",
    "@sanity/table": "^3.1.18",
    "@sanity/ui": "^3.1.14",
    "@sanity/vision": "^5.18.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.6.0",
    "sanity": "^6.15.0",
    "sanity-plugin-internationalized-array": "^5.1.1",
    "sanity-plugin-media": "^4.1.1",
    "sanity-plugin-mux-input": "^2.17.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@hmidmismi/tsconfig": "workspace:*",
    "@sanity/cli": "^8.12.0",
    "@types/react": "^19.2.17",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  },
  "license": "UNLICENSED"
}
