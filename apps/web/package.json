{
  "name": "@yvml/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf .next .turbo node_modules styled-system",
    "typegen": "pnpm --filter @yvml/studio typegen:generate",
    "panda:build": "panda codegen && panda cssgen --outfile styled-system/styles.css",
    "panda:watch": "panda cssgen --outfile styled-system/styles.css --watch",
    "predev": "pnpm typegen && pnpm panda:build",
    "dev": "concurrently -k -n css,next -c magenta,green \"pnpm panda:watch\" \"next dev\"",
    "prebuild": "pnpm typegen && pnpm panda:build",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --ignore-pattern styled-system .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@capsizecss/metrics": "^4.3.0",
    "@clerk/nextjs": "^7.10.8",
    "@hmidmismi/sanity-types": "workspace:*",
    "@hmidmismi/ui": "workspace:*",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^7.27.0",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/visual-editing": "^6.2.0",
    "groq": "^6.24.0",
    "lucide-react": "^1.66.0",
    "next": "15.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@hmidmismi/tsconfig": "workspace:*",
    "@pandacss/dev": "^1.12.0",
    "@pandacss/preset-base": "^1.12.0",
    "@pandacss/preset-panda": "^1.12.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
