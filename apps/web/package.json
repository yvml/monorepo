{
  "name": "@yvml/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf .next .turbo node_modules styled-system",
    "typegen": "pnpm --filter @yvml/studio typegen:generate",
    "panda:build": "panda codegen --clean && panda cssgen --outfile styled-system/styles.css",
    "panda:watch": "panda cssgen --outfile styled-system/styles.css --watch",
    "predev": "pnpm typegen && pnpm panda:build",
    "dev": "concurrently -k -n css,next -c magenta,green \"pnpm panda:watch\" \"next dev\"",
    "prebuild": "pnpm typegen && pnpm panda:build",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --ignore-pattern styled-system .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@capsizecss/metrics": "^4.5.0",
    "@clerk/nextjs": "^7.10.9",
    "@hmidmismi/sanity-types": "workspace:*",
    "@hmidmismi/ui": "workspace:*",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.17.0",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/visual-editing": "^6.2.1",
    "groq": "^6.25.0",
    "lucide-react": "^1.79.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capsizecss/unpack": "^4.0.1",
    "@hmidmismi/tsconfig": "workspace:*",
    "@pandacss/dev": "^2.6.0",
    "@pandacss/preset-base": "^2.6.0",
    "@pandacss/preset-panda": "^2.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
