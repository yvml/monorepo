# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Preview site only. Never set these on the live site.
PREVIEW_SITE=false
PREVIEW_REQUIRE_LOGIN=true
SANITY_API_READ_TOKEN=          # Viewer token, sanity.io/manage > API > Tokens
SANITY_STUDIO_URL=http://localhost:3333

# Auth (@hmidmismi/auth), preview site only
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
BETTER_AUTH_SECRET=             # openssl rand -base64 32
SITE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=           # callback: <SITE_URL>/api/auth/callback/google
GOOGLE_ALLOWED_DOMAINS=         # comma separated, e.g. example.com
GOOGLE_ALLOWED_EMAILS=          # comma separated
