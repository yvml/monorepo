# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Preview site only. Never set these on the live site.
PREVIEW_SITE=false
PREVIEW_REQUIRE_LOGIN=true      # false for local development: no login, and the login middleware is not built
SANITY_API_READ_TOKEN=          # Viewer token, sanity.io/manage > API > Tokens
SANITY_STUDIO_URL=http://localhost:3333

# Preview login: Clerk, with its Google connector. Only used when PREVIEW_SITE=true and PREVIEW_REQUIRE_LOGIN is not false.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
PREVIEW_ALLOWED_EMAILS=         # comma separated addresses and @domain entries, e.g. jason@example.com, @yvml.org
PREVIEW_COOKIE_SECRET=          # 32+ random characters (openssl rand -base64 32); signs the credential the studio's iframe carries
