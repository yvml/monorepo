{
  "name": "yvml",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@yvml/web",
    "dev:studio": "turbo run dev --filter=@yvml/studio",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typegen": "pnpm --filter @yvml/studio typegen",
    "auth:create-user": "pnpm --filter @hmidmismi/auth create-user",
    "clean": "turbo run clean && rm -rf .turbo node_modules",
    "format": "biome format --write .",
    "sync": "git pull && git submodule update --init"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "concurrently": "^9.2.5",
    "oxlint": "^0.16.12",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
